# ── LLM (OpenRouter) ─────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Pick any model from https://openrouter.ai/models (this is where you set the model).
# Good defaults: anthropic/claude-sonnet-4.5  |  openai/gpt-4o-mini (cheap testing)
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Optional: shown to OpenRouter for attribution/rankings
OPENROUTER_APP_URL=http://localhost:8000
OPENROUTER_APP_NAME=LeadSearch

# ── Web search (Tavily) ──────────────────────────────────────────
# Get a key at https://app.tavily.com
TAVILY_API_KEY=

# ── Fallback page fetch (Firecrawl) ──────────────────────────────
# Get a key at https://www.firecrawl.dev
FIRECRAWL_API_KEY=

# ── LinkedIn scraping (Apify) ────────────────────────────────────
# Get a token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=
# The Apify actor to run for LinkedIn profiles.
# Recommended: harvestapi/linkedin-profile-scraper  (no cookies, $4 per 1k profiles).
# Leave blank to skip LinkedIn scraping (LinkedIn URLs then fall back to Firecrawl/Tavily).
APIFY_LINKEDIN_ACTOR=harvestapi/linkedin-profile-scraper
# Set to true to also have the actor look up an email ($10 per 1k instead of $4).
APIFY_LINKEDIN_EMAIL=false

# LinkedIn DISCOVERY actor — finds the profile when no URL is in the sheet.
# Recommended: harvestapi/linkedin-profile-search-by-name  ($3 per 1k, no rate limits).
APIFY_LINKEDIN_SEARCH_ACTOR=harvestapi/linkedin-profile-search-by-name
# "Short" = URLs + basic data (cheapest) | "Full" = full profile inline | "Full + email search"
APIFY_LINKEDIN_SEARCH_MODE=Full
APIFY_LINKEDIN_SEARCH_MAXITEMS=5

# ── Screening console (RAG fit-evaluator, ForRAG service) ────────────────
# After refinement, each lead's LinkedIn profile is screened for fit. Base URL +
# key here so we can flip to the secured/HTTPS endpoint in one place.
SCREENING_URL=http://150.230.237.181/api/screen
SCREENING_API_KEY=
SCREENING_ENABLED=true
SCREENING_TIMEOUT=60

# ── Google Sheets (optional: read source sheet, write destination sheet) ──
# Service-account key: paste the whole JSON here, OR a path to the .json file.
# Create it in Google Cloud Console (enable the Google Sheets API), then share
# the SOURCE sheet with the service account email as Viewer, and the DEST sheet
# as Editor. The sheet ID is the long string in the sheet URL:
#   https://docs.google.com/spreadsheets/d/<THIS_IS_THE_ID>/edit
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SOURCE_SHEET_ID=
# Source tab(s): blank = read ALL tabs (e.g. websites / meta ads / other),
# or a comma-separated list of tab names to read only those. Each tab is
# column-mapped independently, so different per-source layouts are fine.
GOOGLE_SOURCE_TAB=
GOOGLE_DEST_SHEET_ID=
GOOGLE_DEST_TAB=

# ── Auto-ingest scheduler (optional) ─────────────────────────────
# When true, the app checks the source sheet every SCHEDULER_INTERVAL_SECONDS,
# ingests only NEW leads (deduped), runs the pipeline, and pushes results.
# OFF by default (it spends money + writes to the sheet). Baseline the backlog
# first (POST /api/sheets/baseline) if you only want NEW leads processed.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=900
SCHEDULER_MAX_PER_CYCLE=50

# ── AE distribution (optional; defaults shown) ───────────────────
# AE_ROUND_ROBIN=Vansh,Rahul,Agustina,Rocio
# AE_LATAM=Agustina,Rocio
# AE_PILOT=Rahul

# ── Pipeline tuning ──────────────────────────────────────────────
# Decision thresholds on the top candidate's match score (0.0 - 1.0)
ACCEPT_THRESHOLD=0.75
REVIEW_THRESHOLD=0.45
# Max search results considered per lead, and max candidates we deeply fetch+match
MAX_RESULTS_PER_LEAD=8
MAX_CANDIDATES_MATCHED=5
# If Tavily's returned content for a URL is at least this many chars (and not a PDF/
# heavy-JS page), we use it directly instead of calling Firecrawl.
MIN_CONTENT_CHARS=600
