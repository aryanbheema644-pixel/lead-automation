# ── LLM (OpenRouter) ─────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Pick any model from https://openrouter.ai/models (this is where you set the model).
# Good defaults: anthropic/claude-sonnet-4.5  |  openai/gpt-4o-mini (cheap testing)
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Optional: shown to OpenRouter for attribution/rankings
OPENROUTER_APP_URL=http://localhost:8000
OPENROUTER_APP_NAME=LeadSearch

# ── Web search (Tavily) ──────────────────────────────────────────
# Get a key at https://app.tavily.com
TAVILY_API_KEY=

# ── Fallback page fetch (Firecrawl) ──────────────────────────────
# Get a key at https://www.firecrawl.dev
FIRECRAWL_API_KEY=

# ── LinkedIn scraping (Apify) ────────────────────────────────────
# Get a token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=
# The Apify actor to run for LinkedIn profiles.
# Recommended: harvestapi/linkedin-profile-scraper  (no cookies, $4 per 1k profiles).
# Leave blank to skip LinkedIn scraping (LinkedIn URLs then fall back to Firecrawl/Tavily).
APIFY_LINKEDIN_ACTOR=harvestapi/linkedin-profile-scraper
# Set to true to also have the actor look up an email ($10 per 1k instead of $4).
APIFY_LINKEDIN_EMAIL=false

# LinkedIn DISCOVERY actor — finds the profile when no URL is in the sheet.
# Recommended: harvestapi/linkedin-profile-search-by-name  ($3 per 1k, no rate limits).
APIFY_LINKEDIN_SEARCH_ACTOR=harvestapi/linkedin-profile-search-by-name
# "Short" = URLs + basic data (cheapest) | "Full" = full profile inline | "Full + email search"
APIFY_LINKEDIN_SEARCH_MODE=Full
APIFY_LINKEDIN_SEARCH_MAXITEMS=5

# ── Pipeline tuning ──────────────────────────────────────────────
# Decision thresholds on the top candidate's match score (0.0 - 1.0)
ACCEPT_THRESHOLD=0.75
REVIEW_THRESHOLD=0.45
# Max search results considered per lead, and max candidates we deeply fetch+match
MAX_RESULTS_PER_LEAD=8
MAX_CANDIDATES_MATCHED=5
# If Tavily's returned content for a URL is at least this many chars (and not a PDF/
# heavy-JS page), we use it directly instead of calling Firecrawl.
MIN_CONTENT_CHARS=600
